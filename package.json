{
  "name": "nextjs-template",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "//test": "Two layers. `test` is Vitest — pure modules and component logic, fast, jsdom. `test:e2e` is Playwright — the shared systems in a real browser, because animations, layout and timing are where this codebase's bugs actually live. See docs/rules/16-testing.md.",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "setup": "node ncube.js setup",
    "init": "node ncube.js init"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.67.0",
    "@tanstack/react-query-devtools": "^5.67.0",
    "@types/big.js": "^7.0.0",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.6.3",
    "lucide-react": "^0.475.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sonner": "^2.0.1",
    "tailwind-merge": "^2.5.5",
    "tw-animate-css": "^1.2.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
